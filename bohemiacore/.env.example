# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================
DB_USER=postgres
DB_PASSWORD=tu_contraseña_postgres
DB_HOST=localhost
DB_PORT=5432

# ============================================
# CONFIGURACIÓN DE DJANGO
# ============================================
SECRET_KEY=tu-clave-secreta-super-segura-cambiar-en-produccion
DEBUG=True

# ============================================
# CONFIGURACIÓN DE EMAIL (Gmail SMTP)
# ============================================
# Para usar Gmail:
# 1. Activa 2FA en tu cuenta de Google
# 2. Genera una contraseña de aplicación en:
#    https://myaccount.google.com/apppasswords
# 3. Copia la contraseña generada en EMAIL_HOST_PASSWORD
# 4. Usa tu correo de Gmail en EMAIL_HOST_USER

EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion

# ============================================
# MERCADO PAGO - CHECKOUT C1 (sólo backend)
# ============================================
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-reemplazar
MERCADO_PAGO_CHECKOUT_CURRENCY=ARS
MERCADO_PAGO_CHECKOUT_TIMEOUT_SECONDS=8
MERCADO_PAGO_CHECKOUT_TTL_MINUTES=30
MERCADO_PAGO_CHECKOUT_SUCCESS_URL=http://localhost:3000/compra-exitosa
MERCADO_PAGO_CHECKOUT_PENDING_URL=http://localhost:3000/compra-pendiente
MERCADO_PAGO_CHECKOUT_FAILURE_URL=http://localhost:3000/compra-fallida

